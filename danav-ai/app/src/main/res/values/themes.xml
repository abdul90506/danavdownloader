<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#18181B</color>
    <color name="accent">#DC2626</color>
    <color name="bg">#FFFFFF</color>
    <color name="bg_dark">#0F0F10</color>
    <color name="launcher_bg">#18181B</color>
    <style name="Danav" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
    <style name="Danav.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
</resources>
